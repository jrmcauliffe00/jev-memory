# --- MongoDB Atlas -----------------------------------------------------------
# Leave empty to use the in-memory store.
MONGODB_URI=
MONGODB_DB=jev

# --- Jev classifier (Together AI or a local OpenAI-compatible server) --------
# Leave TOGETHER_API_KEY empty to use the built-in stub
# (unless JEV_BASE_URL points at a local server).
TOGETHER_API_KEY=
# JEV_BASE_URL=http://127.0.0.1:8080/v1
TOGETHER_MODEL=
# JEV_MODEL is used only when TOGETHER_MODEL is empty.
JEV_MODEL=

# --- Embeddings (OpenAI) -----------------------------------------------------
# Leave empty to use a local pseudo-embedding (dev only).
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
