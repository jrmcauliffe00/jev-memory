# --- MongoDB Atlas (the brain) -------------------------------------------------
# SRV connection string from Atlas -> Connect -> Drivers -> Node.js
# Leave empty to run the demo entirely in-memory (no cloud, "insurance" mode).
MONGODB_URI=
# Database name (created on first write).
MONGODB_DB=jev

# --- Jev classifier (Together AI or local MLX) --------------------------------
# Leave TOGETHER_API_KEY empty to use the built-in deterministic Jev stub
# (unless JEV_BASE_URL points at a local server).
TOGETHER_API_KEY=
# Local on-device server (npm run jev:serve). Overrides Together hosting.
# JEV_BASE_URL=http://127.0.0.1:8080/v1
# Model id precedence (matches tev1/examples/decide.py): TOGETHER_MODEL wins, then JEV_MODEL,
# then the hosted serverless default `together/Tev1-4B-experimental`.
# For local MLX, set this to the served model path (models/jev-4b-mlx).
TOGETHER_MODEL=
# JEV_MODEL is the blog-compatible alias, used only when TOGETHER_MODEL is empty.
JEV_MODEL=

# --- Embeddings + harness model (OpenAI) --------------------------------------
# Leave empty to use a deterministic local pseudo-embedding (dev/offline only).
OPENAI_API_KEY=
# Embedding model — MUST be 1536-dim to match the Atlas vector index.
EMBED_MODEL=text-embedding-3-small
# The model the Strands harness agent runs on.
HARNESS_MODEL=openai/gpt-5.6-sol
