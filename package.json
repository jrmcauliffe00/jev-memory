{
  "name": "jev-memory",
  "version": "0.1.0",
  "description": "Self-improving, MongoDB-backed memory for Strands agents, gated by a type-safe classifier (Jev).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "setup:index": "tsx src/setupIndex.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/seed.ts",
    "ingest": "tsx src/ingest/worker.ts",
    "watch": "tsx src/ingest/worker.ts --watch",
    "demo": "tsx src/demo.ts",
    "evolve": "tsx src/evolve.ts"
  },
  "dependencies": {
    "@strands-agents/harness": "^0.1.1",
    "dotenv": "^18.0.4",
    "mongodb": "^7.6.0",
    "openai": "^6.49.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
